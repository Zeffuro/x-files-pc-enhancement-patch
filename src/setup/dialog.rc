#include <windows.h>

105 DIALOGEX 0, 0, 360, 374
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "The X-Files Setup"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Install The X-Files", -1, 12, 12, 330, 14
    LTEXT "Choose your game files or disc images. Setup detects the game language.", -1, 12, 32, 336, 28
    LTEXT "Game files or disc images", -1, 12, 66, 250, 12
    EDITTEXT 1101, 12, 80, 212, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Folder...", 1102, 230, 80, 56, 16
    PUSHBUTTON "Image...", 1110, 292, 80, 56, 16
    LTEXT "Game media", -1, 12, 106, 72, 12
    COMBOBOX 1113, 88, 104, 260, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "French CD source (required for French DVD title)", -1, 12, 132, 336, 12
    EDITTEXT 1114, 12, 146, 212, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Folder...", 1115, 230, 146, 56, 16
    PUSHBUTTON "Image...", 1116, 292, 146, 56, 16
    LTEXT "Install to a new folder", -1, 12, 182, 280, 12
    EDITTEXT 1103, 12, 196, 274, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Browse...", 1104, 292, 196, 56, 16
    CONTROL "Start in a window", 1105, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 222, 240, 13
    CONTROL "Desktop shortcut", 1108, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 242, 150, 13
    CONTROL "Start Menu shortcut", 1109, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 184, 242, 162, 13
    LTEXT "Interface language (independent of game media)", 1111, 12, 262, 233, 27
    COMBOBOX 1112, 250, 261, 98, 88, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Updating? Close the game and extract the new release ZIP into the installed folder. Replace files when asked. Saves and settings are kept.", 1106, 12, 290, 336, 28
    CONTROL "", 1107, "msctls_progress32", WS_BORDER, 12, 324, 336, 9
    DEFPUSHBUTTON "Install", IDOK, 218, 346, 70, 17
    PUSHBUTTON "Cancel", IDCANCEL, 294, 346, 54, 17
END
