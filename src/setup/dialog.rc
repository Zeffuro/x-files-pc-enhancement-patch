#include <windows.h>

105 DIALOGEX 0, 0, 360, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "The X-Files Setup"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Install The X-Files", -1, 12, 12, 330, 14
    LTEXT "Choose your game files or disc images. Setup detects the game language.", -1, 12, 32, 336, 28
    LTEXT "Game files or disc images", -1, 12, 66, 250, 12
    EDITTEXT 1101, 12, 80, 212, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Folder...", 1102, 230, 80, 56, 16
    PUSHBUTTON "Image...", 1110, 292, 80, 56, 16
    LTEXT "Install to a new folder", -1, 12, 108, 280, 12
    EDITTEXT 1103, 12, 122, 274, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Browse...", 1104, 292, 122, 56, 16
    CONTROL "Start in a window", 1105, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 148, 240, 13
    CONTROL "Desktop shortcut", 1108, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 168, 150, 13
    CONTROL "Start Menu shortcut", 1109, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 184, 168, 162, 13
    LTEXT "Interface language (independent of game media)", 1111, 12, 188, 233, 27
    COMBOBOX 1112, 250, 187, 98, 88, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Updating? Close the game and extract the new release ZIP into the installed folder. Replace files when asked. Saves and settings are kept.", 1106, 12, 216, 336, 28
    CONTROL "", 1107, "msctls_progress32", WS_BORDER, 12, 250, 336, 9
    DEFPUSHBUTTON "Install", IDOK, 218, 272, 70, 17
    PUSHBUTTON "Cancel", IDCANCEL, 294, 272, 54, 17
END
