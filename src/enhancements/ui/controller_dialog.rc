#pragma code_page(65001)
#include <windows.h>
#include "controller_resources.h"

IDD_CONTROLLER_CONFIG DIALOGEX 0, 0, 470, 294
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configure controller"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Bindings", -1, 10, 8, 213, 252
    LTEXT "Choose an action, then assign a button.", -1, 20, 23, 192, 24
    LISTBOX IDC_CONTROLLER_ACTIONS, 20, 49, 192, 116, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "Assigned button", -1, 20, 172, 192, 12
    COMBOBOX IDC_CONTROLLER_BINDING, 20, 188, 192, 135, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Capture button", IDC_CONTROLLER_CAPTURE, 20, 212, 192, 18
    LTEXT "Assignments swap to keep every action available.", -1, 20, 236, 192, 20
    GROUPBOX "Calibration", -1, 233, 8, 227, 168
    LTEXT "Stick deadzone (0-30000)", -1, 243, 25, 152, 12
    EDITTEXT IDC_CONTROLLER_DEADZONE, 402, 22, 48, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Sensitivity (25-300%)", -1, 243, 47, 152, 12
    EDITTEXT IDC_CONTROLLER_SENSITIVITY, 402, 44, 48, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Response curve", -1, 243, 69, 101, 12
    COMBOBOX IDC_CONTROLLER_CURVE, 348, 66, 102, 75, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Trigger threshold (0-254)", -1, 243, 91, 152, 12
    EDITTEXT IDC_CONTROLLER_TRIGGER, 402, 88, 48, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Invert stick X", IDC_CONTROLLER_INVERT_X, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 243, 114, 207, 13
    CONTROL "Invert stick Y", IDC_CONTROLLER_INVERT_Y, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 243, 131, 207, 13
    LTEXT "Curve changes pointer speed. Spring movement is linear.", -1, 243, 149, 207, 20
    GROUPBOX "Live input", -1, 233, 184, 227, 76
    LTEXT "", IDC_CONTROLLER_LIVE, 243, 198, 207, 33
    LTEXT "", IDC_CONTROLLER_STATUS, 243, 235, 207, 22
    PUSHBUTTON "Reset recommended", IDC_CONTROLLER_RESET, 10, 270, 140, 18
    DEFPUSHBUTTON "OK", IDOK, 310, 270, 70, 18
    PUSHBUTTON "Cancel", IDCANCEL, 390, 270, 70, 18
END

