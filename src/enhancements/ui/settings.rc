#include <windows.h>
#include <commctrl.h>
#include "resources.h"

IDD_ENHANCEMENTS DIALOGEX 0, 0, 372, 256
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "The X-Files enhancements"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, WC_TABCONTROL, WS_TABSTOP, 10, 8, 352, 210
    GROUPBOX "Display and audio", IDC_SETTINGS_DISPLAY, 16, 36, 340, 169
    LTEXT "Display mode", -1, 26, 53, 90, 12
    COMBOBOX IDC_DISPLAY_MODE, 122, 50, 222, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Alt+Enter switches display mode.", -1, 122, 69, 139, 12
    PUSHBUTTON "Movie preview...", IDC_MOVIE_PREVIEW, 264, 67, 80, 16
    LTEXT "Window size", -1, 26, 89, 90, 12
    COMBOBOX IDC_WINDOW_SIZE, 122, 86, 222, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Scaling filter", -1, 26, 110, 90, 12
    COMBOBOX IDC_SCALING_FILTER, 122, 107, 222, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Movie colors", -1, 26, 128, 90, 12
    COMBOBOX IDC_MOVIE_CONTRAST, 122, 125, 222, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Audio output", -1, 26, 145, 90, 12
    COMBOBOX IDC_AUDIO_DEVICE, 122, 142, 222, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Fast-forward", -1, 26, 164, 90, 12
    COMBOBOX IDC_MOVIE_SPEED, 122, 161, 54, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Mute fast-forward", IDC_MOVIE_SPEED_MUTE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 188, 161, 156, 12
    CONTROL "Use DVD movies", IDC_DVD_MOVIES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 183, 150, 12
    CONTROL "Deinterlace DVD video", IDC_DVD_DEINTERLACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 188, 183, 156, 12
    GROUPBOX "Controller", IDC_SETTINGS_CONTROLLER, 16, 36, 340, 142
    CONTROL "Enable gamepad", IDC_GAMEPAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 51, 150, 12
    CONTROL "Controller vibration", IDC_VIBRATION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 188, 51, 156, 12
    CONTROL "Analog stick moves pointer (D-pad selects controls)", IDC_ANALOG_CURSOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 67, 326, 12
    CONTROL "Spring-centred pointer (return to centre on release)", IDC_SPRING_CURSOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 38, 83, 310, 12
    LTEXT "Focus highlight", -1, 26, 100, 90, 12
    COMBOBOX IDC_FOCUS_HIGHLIGHT, 122, 97, 222, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Controller hints (button positions)", IDC_CONTROLLER_HINTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 116, 318, 12
    PUSHBUTTON "Configure controller...", IDC_CONFIGURE_CONTROLLER, 26, 142, 318, 18
    GROUPBOX "Subtitles", IDC_SETTINGS_SUBTITLES, 16, 36, 340, 118
    LTEXT "Closed captions", -1, 26, 53, 90, 12
    COMBOBOX IDC_CAPTIONS, 122, 50, 222, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Font", -1, 26, 71, 90, 12
    COMBOBOX IDC_CAPTION_FONT, 122, 68, 222, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Size (%)", -1, 26, 89, 90, 12
    EDITTEXT IDC_CAPTION_SCALE, 122, 86, 44, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "75 to 200", -1, 176, 89, 100, 12
    CONTROL "Dark background", IDC_CAPTION_BACKGROUND, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 107, 145, 12
    COMBOBOX IDC_CAPTION_COLOR, 188, 104, 153, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Opacity", -1, 26, 132, 72, 12
    CONTROL "", IDC_CAPTION_OPACITY, TRACKBAR_CLASS, TBS_HORZ | WS_TABSTOP, 118, 127, 226, 18
    GROUPBOX "Game", IDC_SETTINGS_GAME, 16, 36, 340, 103
    CONTROL "Restore black menu backgrounds", IDC_MENU_BLACK, "Button", BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP, 26, 51, 164, 18
    CONTROL "Skip workstation login puzzle", IDC_SKIP_LOGIN, "Button", BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP, 200, 51, 144, 18
    CONTROL "Skip menu logo and entrance animations", IDC_SKIP_MENU, "Button", BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP, 26, 71, 164, 18
    CONTROL "Save browser with thumbnails", IDC_SAVE_BROWSER, "Button", BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP, 200, 71, 144, 18
    CONTROL "Dialogue transcript", IDC_DIALOGUE_TRANSCRIPT, "Button", BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP, 26, 91, 164, 18
    PUSHBUTTON "Quick menu...", IDC_QUICK_MENU, 200, 91, 144, 18
    LTEXT "Interface language", -1, 26, 119, 92, 12
    COMBOBOX IDC_INTERFACE_LANGUAGE, 122, 116, 222, 95, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_BUILD_VERSION, 10, 235, 85, 12
    PUSHBUTTON "Tools...", IDC_TOOLS, 102, 232, 65, 16
    PUSHBUTTON "GitHub", IDC_GITHUB, 173, 232, 55, 16
    DEFPUSHBUTTON "OK", IDOK, 246, 232, 55, 16
    PUSHBUTTON "Cancel", IDCANCEL, 307, 232, 55, 16
END


IDD_QUICK_MENU DIALOGEX 0, 0, 220, 176
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Quick menu"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Enable", IDC_QUICK_MENU_ENABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 196, 12
    GROUPBOX "Visible buttons", -1, 12, 32, 196, 112
    CONTROL "Save", IDC_QUICK_MENU_SAVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 48, 172, 12
    CONTROL "Load", IDC_QUICK_MENU_LOAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 66, 172, 12
    CONTROL "Transcript", IDC_QUICK_MENU_TRANSCRIPT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 84, 172, 12
    CONTROL "Tweaks", IDC_QUICK_MENU_TWEAKS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 102, 172, 12
    CONTROL "Menu", IDC_QUICK_MENU_MENU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 120, 172, 12
    DEFPUSHBUTTON "OK", IDOK, 92, 152, 55, 16
    PUSHBUTTON "Cancel", IDCANCEL, 153, 152, 55, 16
END

IDD_MOVIE_PREVIEW DIALOGEX 0, 0, 500, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Movie color preview"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Compare short, silent scenes from early locations. Gameplay stays paused.", -1, 12, 10, 476, 14
    LTEXT "Preview scene", -1, 12, 30, 66, 14
    COMBOBOX IDC_PREVIEW_SAMPLE, 82, 27, 298, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Play preview", IDC_PREVIEW_PLAY, 390, 27, 98, 17
    LTEXT "Original", -1, 12, 52, 225, 12
    LTEXT "Selected colors", -1, 255, 52, 233, 12
    CONTROL "", IDC_PREVIEW_IMAGE, "Static", SS_OWNERDRAW, 12, 69, 476, 118
    COMBOBOX IDC_MOVIE_CONTRAST, 12, 196, 245, 85, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_PREVIEW_STATUS, 12, 218, 476, 22
    DEFPUSHBUTTON "Use selection", IDOK, 316, 242, 82, 16
    PUSHBUTTON "Cancel", IDCANCEL, 410, 242, 78, 16
END

IDD_TOOLS DIALOGEX 0, 0, 340, 328
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "The X-Files tools"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Troubleshooting", -1, 10, 8, 320, 84
    LTEXT "Save logs and version details to a ZIP for a bug report. You can include a saved game. Nothing is uploaded.", -1, 20, 23, 297, 24
    CONTROL "Include a saved game...", IDC_REPORT_SAVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 51, 297, 12
    PUSHBUTTON "Open logs folder", IDC_OPEN_LOGS, 20, 69, 145, 16
    PUSHBUTTON "Save report ZIP...", IDC_SAVE_REPORT, 173, 69, 145, 16
    GROUPBOX "Saved games", -1, 10, 99, 320, 67
    LTEXT "Load during exploration or from the main menu. Loading discards unsaved progress. Save during exploration using a new filename.", -1, 20, 114, 297, 24
    PUSHBUTTON "Load from file...", IDC_LOAD_CHECKPOINT, 20, 143, 145, 16
    PUSHBUTTON "Save to file...", IDC_EXPORT_SAVE, 173, 143, 145, 16
    GROUPBOX "Subtitles", -1, 10, 173, 320, 67
    LTEXT "Export movie captions as editable SRT files, or install a subtitle pack. Original movies aren't changed.", -1, 20, 188, 297, 24
    PUSHBUTTON "Export subtitles...", IDC_EXPORT_SUBTITLES, 20, 217, 145, 16
    PUSHBUTTON "Install subtitles...", IDC_INSTALL_SUBTITLES, 173, 217, 145, 16
    GROUPBOX "Developer tools", -1, 10, 247, 320, 48
    LTEXT "Preview live clips and add your own labels and notes.", -1, 20, 260, 297, 12
    PUSHBUTTON "Open developer tools...", IDC_CLIP_INSPECTOR, 20, 275, 145, 16
    LTEXT "Ctrl+F11 opens it during play.", -1, 173, 278, 145, 12
    LTEXT "", IDC_BUILD_VERSION, 10, 307, 175, 12
    PUSHBUTTON "About...", IDC_ABOUT, 208, 304, 59, 16
    DEFPUSHBUTTON "Close", IDCANCEL, 275, 304, 55, 16
END

IDD_SUBTITLE_PROGRESS DIALOGEX 0, 0, 300, 82
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Subtitles"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_SUBTITLE_STATUS, 12, 12, 276, 18
    CONTROL "", IDC_SUBTITLE_PROGRESS, "msctls_progress32", WS_BORDER, 12, 34, 276, 12
    PUSHBUTTON "Cancel", IDCANCEL, 233, 56, 55, 16
END

201 BITMAP "assets/tweaks.bmp"
