#include <windows.h>
#include <commctrl.h>
#include "resources.h"

IDD_ENHANCEMENTS DIALOGEX 0, 0, 372, 496
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "The X-Files enhancements"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Display and audio", -1, 10, 8, 352, 131
    LTEXT "Display mode", -1, 20, 25, 90, 12
    COMBOBOX IDC_DISPLAY_MODE, 116, 22, 234, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Alt+Enter switches between windowed and borderless.", -1, 116, 41, 232, 12
    LTEXT "Window size", -1, 20, 61, 90, 12
    COMBOBOX IDC_WINDOW_SIZE, 116, 58, 234, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Scaling filter", -1, 20, 82, 90, 12
    COMBOBOX IDC_SCALING_FILTER, 116, 79, 234, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Original proportions. Filters require Direct3D 9.", -1, 116, 98, 232, 12
    LTEXT "Audio output", -1, 20, 117, 90, 12
    COMBOBOX IDC_AUDIO_DEVICE, 116, 114, 234, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Controller", -1, 10, 146, 352, 82
    CONTROL "Enable gamepad", IDC_GAMEPAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 161, 150, 12
    CONTROL "Analog stick moves pointer (D-pad selects controls)", IDC_ANALOG_CURSOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 177, 326, 12
    CONTROL "Spring-centred pointer (return to centre on release)", IDC_SPRING_CURSOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 32, 193, 310, 12
    LTEXT "Focus highlight", -1, 20, 210, 90, 12
    COMBOBOX IDC_FOCUS_HIGHLIGHT, 116, 207, 234, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Subtitles", -1, 10, 235, 352, 118
    LTEXT "Closed captions", -1, 20, 252, 90, 12
    COMBOBOX IDC_CAPTIONS, 116, 249, 234, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Font", -1, 20, 270, 90, 12
    COMBOBOX IDC_CAPTION_FONT, 116, 267, 234, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Size (%)", -1, 20, 288, 90, 12
    EDITTEXT IDC_CAPTION_SCALE, 116, 285, 44, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "75 to 200", -1, 170, 288, 100, 12
    CONTROL "Dark background", IDC_CAPTION_BACKGROUND, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 306, 145, 12
    COMBOBOX IDC_CAPTION_COLOR, 182, 303, 165, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Opacity", -1, 20, 331, 72, 12
    CONTROL "", IDC_CAPTION_OPACITY, TRACKBAR_CLASS, TBS_HORZ | WS_TABSTOP, 112, 326, 238, 18
    GROUPBOX "Game", -1, 10, 360, 352, 103
    CONTROL "Restore black menu backgrounds", IDC_MENU_BLACK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 375, 330, 12
    CONTROL "Skip workstation login puzzle", IDC_SKIP_LOGIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 391, 330, 12
    CONTROL "Skip menu logo and entrance animations", IDC_SKIP_MENU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 407, 330, 12
    CONTROL "Save browser with thumbnails", IDC_SAVE_BROWSER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 423, 330, 12
    LTEXT "Interface language", -1, 20, 443, 92, 12
    COMBOBOX IDC_INTERFACE_LANGUAGE, 116, 440, 234, 95, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_BUILD_VERSION, 10, 475, 85, 12
    PUSHBUTTON "Tools...", IDC_TOOLS, 102, 472, 65, 16
    PUSHBUTTON "GitHub", IDC_GITHUB, 173, 472, 55, 16
    DEFPUSHBUTTON "OK", IDOK, 246, 472, 55, 16
    PUSHBUTTON "Cancel", IDCANCEL, 307, 472, 55, 16
END

IDD_TOOLS DIALOGEX 0, 0, 340, 328
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "The X-Files tools"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Troubleshooting", -1, 10, 8, 320, 84
    LTEXT "Save logs and version details to a ZIP for a bug report. You can include a saved game. Nothing is uploaded.", -1, 20, 23, 297, 24
    CONTROL "Include a saved game...", IDC_REPORT_SAVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 51, 297, 12
    PUSHBUTTON "Open logs folder", IDC_OPEN_LOGS, 20, 69, 145, 16
    PUSHBUTTON "Save report ZIP...", IDC_SAVE_REPORT, 173, 69, 145, 16
    GROUPBOX "Saved games", -1, 10, 99, 320, 67
    LTEXT "Load during exploration or from the main menu. Loading discards unsaved progress. Save during exploration using a new filename.", -1, 20, 114, 297, 24
    PUSHBUTTON "Load from file...", IDC_LOAD_CHECKPOINT, 20, 143, 145, 16
    PUSHBUTTON "Save to file...", IDC_EXPORT_SAVE, 173, 143, 145, 16
    GROUPBOX "Subtitles", -1, 10, 173, 320, 67
    LTEXT "Export movie captions as editable SRT files, or install a subtitle pack. Original movies aren't changed.", -1, 20, 188, 297, 24
    PUSHBUTTON "Export subtitles...", IDC_EXPORT_SUBTITLES, 20, 217, 145, 16
    PUSHBUTTON "Install subtitles...", IDC_INSTALL_SUBTITLES, 173, 217, 145, 16
    GROUPBOX "Developer tools", -1, 10, 247, 320, 48
    LTEXT "Preview live clips and add your own labels and notes.", -1, 20, 260, 297, 12
    PUSHBUTTON "Open developer tools...", IDC_CLIP_INSPECTOR, 20, 275, 145, 16
    LTEXT "Ctrl+F11 opens it during play.", -1, 173, 278, 145, 12
    LTEXT "", IDC_BUILD_VERSION, 10, 307, 175, 12
    PUSHBUTTON "About...", IDC_ABOUT, 208, 304, 59, 16
    DEFPUSHBUTTON "Close", IDCANCEL, 275, 304, 55, 16
END

IDD_SUBTITLE_PROGRESS DIALOGEX 0, 0, 300, 82
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Subtitles"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_SUBTITLE_STATUS, 12, 12, 276, 18
    CONTROL "", IDC_SUBTITLE_PROGRESS, "msctls_progress32", WS_BORDER, 12, 34, 276, 12
    PUSHBUTTON "Cancel", IDCANCEL, 233, 56, 55, 16
END

201 BITMAP "assets/tweaks.bmp"
202 BITMAP "assets/tweaks-de.bmp"
203 BITMAP "assets/tweaks-fr.bmp"
204 BITMAP "assets/tweaks-es.bmp"
205 BITMAP "assets/tweaks-it.bmp"
206 BITMAP "assets/tweaks-ja.bmp"

3 RT_MANIFEST "tool-theme.manifest"

IDD_SUBTITLE_FORMAT DIALOGEX 0, 0, 276, 76
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Subtitles"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_SUBTITLE_STATUS, 12, 10, 252, 26
    DEFPUSHBUTTON "ZIP file...", IDYES, 12, 48, 80, 17
    PUSHBUTTON "Folder...", IDNO, 98, 48, 80, 17
    PUSHBUTTON "Cancel", IDCANCEL, 184, 48, 80, 17
END
