IDD_SUBTITLE_FORMAT DIALOGEX 0, 0, 276, 76
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Subtitles"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_SUBTITLE_STATUS, 12, 10, 252, 26
    DEFPUSHBUTTON "ZIP file...", IDYES, 12, 48, 80, 17
    PUSHBUTTON "Folder...", IDNO, 98, 48, 80, 17
    PUSHBUTTON "Cancel", IDCANCEL, 184, 48, 80, 17
END
