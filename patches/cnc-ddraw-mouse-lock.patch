diff --git a/src/mouse.c b/src/mouse.c
index e2366bb..257fabd 100644
--- a/src/mouse.c
+++ b/src/mouse.c
@@ -5,14 +5,92 @@
 #include "hook.h"
 #include "utils.h"
 #include "config.h"
+#include "mouse.h"
 
 
 BOOL g_mouse_locked;
 HHOOK g_mouse_hook;
 HOOKPROC g_mouse_proc;
 
+static BOOL xfiles_windowed_mouse_enabled;
+static BOOL xfiles_windowed_mouse_locked;
+static BOOL xfiles_windowed_mouse_paused;
+static BOOL xfiles_windowed_mouse_released;
+static BOOL xfiles_windowed_mouse_suspended;
+
+BOOL xfiles_windowed_mouse_active(void)
+{
+    return xfiles_windowed_mouse_enabled && g_config.windowed && !g_config.fullscreen;
+}
+
+LRESULT xfiles_set_windowed_mouse(WPARAM request, LPARAM paused)
+{
+    if ((request == 1 || request == 2) &&
+        (xfiles_windowed_mouse_enabled != (request == 2) || xfiles_windowed_mouse_paused != !!paused))
+    {
+        if (xfiles_windowed_mouse_locked)
+            mouse_unlock();
+        if (xfiles_windowed_mouse_enabled != (request == 2))
+            xfiles_windowed_mouse_released = FALSE;
+        xfiles_windowed_mouse_enabled = request == 2;
+        xfiles_windowed_mouse_paused = !!paused;
+        if (xfiles_windowed_mouse_active())
+            mouse_lock();
+    }
+    return xfiles_windowed_mouse_enabled ? 2 : 1;
+}
+
+void xfiles_release_windowed_mouse(void)
+{
+    if (xfiles_windowed_mouse_active())
+        xfiles_windowed_mouse_released = TRUE;
+    mouse_unlock();
+}
+
+void xfiles_resume_windowed_mouse(void)
+{
+    if (xfiles_windowed_mouse_active() && real_GetForegroundWindow() == g_ddraw.hwnd)
+    {
+        xfiles_windowed_mouse_released = FALSE;
+        mouse_lock();
+    }
+}
+
+void xfiles_suspend_windowed_mouse(BOOL suspend)
+{
+    xfiles_windowed_mouse_suspended = suspend;
+    if (suspend && xfiles_windowed_mouse_locked)
+        mouse_unlock();
+    else if (!suspend && xfiles_windowed_mouse_active())
+        mouse_lock();
+}
+
+void xfiles_refresh_windowed_mouse(void)
+{
+    if (xfiles_windowed_mouse_locked)
+        mouse_lock();
+}
+
 void mouse_lock()
 {
+    if (xfiles_windowed_mouse_active())
+    {
+        if (!g_hook_active || !g_ddraw.ref || !g_ddraw.width || !g_ddraw.render.run ||
+            xfiles_windowed_mouse_released || xfiles_windowed_mouse_suspended || xfiles_windowed_mouse_paused ||
+            xfiles_tool_cursor_active() || g_ddraw.bnet_active || !g_ddraw.hwnd ||
+            util_is_minimized(g_ddraw.hwnd) || real_GetForegroundWindow() != g_ddraw.hwnd)
+            return;
+
+        /* Real APIs use the physical client, including any scaling bars. */
+        RECT rc = { 0 };
+        if (real_GetClientRect(g_ddraw.hwnd, &rc) && !IsRectEmpty(&rc))
+        {
+            real_MapWindowPoints(g_ddraw.hwnd, HWND_DESKTOP, (LPPOINT)&rc, 2);
+            if (real_ClipCursor(&rc))
+                xfiles_windowed_mouse_locked = g_mouse_locked = TRUE;
+        }
+        return;
+    }
     if (xfiles_tool_cursor_active() || g_config.devmode || g_ddraw.bnet_active || !g_ddraw.hwnd)
         return;
 
@@ -55,6 +133,13 @@ void mouse_lock()
 
 void mouse_unlock()
 {
+    if (xfiles_windowed_mouse_locked)
+    {
+        xfiles_windowed_mouse_locked = g_mouse_locked = FALSE;
+        real_ClipCursor(NULL);
+        ReleaseCapture();
+        return;
+    }
     if (g_config.devmode || !g_hook_active || !g_ddraw.hwnd)
         return;
 
