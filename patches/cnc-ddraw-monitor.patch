 #include "config.h"
 #include "versionhelpers.h"
 
+static void util_relocate_restore_rect(RECT* restored, const RECT* previous_work,
+    const RECT* work, DWORD style, BOOL menu, DWORD exstyle)
+{
+    if (IsRectEmpty(previous_work) || EqualRect(previous_work, work))
+        return;
+
+    RECT outer = { 0, 0, restored->right, restored->bottom };
+    if (!AdjustWindowRectEx(&outer, style, menu, exstyle))
+        return;
+
+    /* Preserve the restore offset on the new monitor and keep its titlebar reachable. */
+    int x = restored->left - previous_work->left + work->left + outer.left;
+    int y = restored->top - previous_work->top + work->top + outer.top;
+    int width = outer.right - outer.left;
+    int height = outer.bottom - outer.top;
+    restored->left = max(work->left, min(x, work->right - width)) - outer.left;
+    restored->top = max(work->top, min(y, work->bottom - height)) - outer.top;
+}
+
