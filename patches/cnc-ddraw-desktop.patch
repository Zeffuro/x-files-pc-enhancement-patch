+static LONG xfiles_tool_cursor;
+static unsigned xfiles_modal_depth;
+static BOOL xfiles_modeless_cursor;
+
+BOOL xfiles_tool_cursor_active(void)
+{
+    return InterlockedExchangeAdd(&xfiles_tool_cursor, 0) != 0;
+}
+
+void xfiles_set_tool_cursor(unsigned request)
+{
+    if (request == 3) ++xfiles_modal_depth;
+    else if (request == 4) { if (xfiles_modal_depth) --xfiles_modal_depth; }
+    else if (request < 2) xfiles_modeless_cursor = request != 0;
+    BOOL enabled = xfiles_modal_depth || xfiles_modeless_cursor;
+    if (enabled)
+    {
+        InterlockedExchange(&xfiles_tool_cursor, TRUE);
+        int count = real_ShowCursor(TRUE);
+        if (count > 0) real_ShowCursor(FALSE);
+        else while (count < 0) count = real_ShowCursor(TRUE);
+        /* Keep the game's requested cursor separate from native tool windows. */
+        real_SetCursor(LoadCursor(NULL, IDC_ARROW));
+    }
+    else if (xfiles_tool_cursor_active())
+    {
+        InterlockedExchange(&xfiles_tool_cursor, FALSE);
+        int target = InterlockedExchangeAdd((LONG*)&g_ddraw.show_cursor_count, 0);
+        int count = real_ShowCursor(TRUE) - 1;
+        real_ShowCursor(FALSE);
+        while (count < target) count = real_ShowCursor(TRUE);
+        while (count > target) count = real_ShowCursor(FALSE);
+        real_SetCursor((HCURSOR)InterlockedExchangeAdd((LONG*)&g_ddraw.old_cursor, 0));
+    }
+}
+
 int WINAPI fake_ShowCursor(BOOL bShow)
 {
     if (g_ddraw.ref && g_ddraw.hwnd)
     {
-        if (g_mouse_locked || g_config.devmode)
+        if (!xfiles_tool_cursor_active() && (g_mouse_locked || g_config.devmode))
         {
             int count = real_ShowCursor(bShow);
             InterlockedExchange((LONG*)&g_ddraw.show_cursor_count, count);
@@ -171,7 +207,7 @@ HCURSOR WINAPI fake_SetCursor(HCURSOR hCursor)
     {
         HCURSOR cursor = (HCURSOR)InterlockedExchange((LONG*)&g_ddraw.old_cursor, (LONG)hCursor);
 
-        if (!g_mouse_locked && !g_config.devmode)
+        if (xfiles_tool_cursor_active() || (!g_mouse_locked && !g_config.devmode))
             return cursor;
     }
 
